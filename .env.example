# Token da Apify, usado pela Skill 06 (benchmark de anúncios).
# Gere em console.apify.com → Settings → API & Integrations.
# Copie este arquivo para .env e preencha. O .env nunca vai para o git.
APIFY_TOKEN=

# Chave da API da Anthropic (Console: platform.claude.com → Settings → API Keys).
# Só é usada com PLANEJAMENTO_EXECUTOR=sdk (cobrança por uso, debitada dos créditos do Console).
ANTHROPIC_API_KEY=

# Qual motor roda os agentes no app web:
#   (vazio) = Claude Code logado na máquina, usando a assinatura
#   sdk     = Claude Agent SDK com ANTHROPIC_API_KEY
#   demo    = respostas de mentira, sem gastar nada
PLANEJAMENTO_EXECUTOR=

# Onde ficam os dados dos prospects: (vazio ou fs) = pastas em clientes/; supabase = Supabase (exige as duas variáveis abaixo).
PLANEJAMENTO_DADOS=

# URL do projeto Supabase, usada com PLANEJAMENTO_DADOS=supabase (só o servidor acessa).
SUPABASE_URL=

# Chave de serviço (service_role) do Supabase, usada com PLANEJAMENTO_DADOS=supabase. Nunca vai para o cliente nem para o git.
SUPABASE_SERVICE_ROLE_KEY=

# URL do projeto Supabase usado só nos testes de integração (sem ela esses testes são pulados).
SUPABASE_TESTE_URL=

# Chave de serviço do projeto Supabase de testes de integração.
SUPABASE_TESTE_SERVICE_ROLE_KEY=

# Pasta de configuração do Claude Code (opcional; padrão ~/.claude). Define onde fica a sessão do agente que a nuvem guarda.
CLAUDE_CONFIG_DIR=
