flowchart TD
  I1["Histórico mensal de 12 meses (obrigatório)"]
  I2["Produtos vendidos no ano (para a Curva ABC, Fase 3)"]
  F1["Fase 1 · Macro financeiro: investimento, receita, quebra, ROAS"]
  F2["Fase 2 · Sessões, dependência paga, conversão"]
  F3["Fase 3 · Produtos: Curva ABC, Top 10 e tabela por curva"]
  S1["analista-dados: todos os gráficos da fase, com valor em cada ponto"]
  C1{"Analista aprova?"}
  A1["Escrever a análise de cada KPI: dado, benchmark e suspeita de causa"]
  C2{"Analista aprova?"}
  G1["Salvar gráficos e análises aprovados"]
  D3{"Qual é a fase atual?"}
  P1["Conectar os KPIs: sessões, conversão, receita, dependência, Curva ABC"]
  C3{"Analista aprova?"}
  E1["Entrega: diagnóstico com achados prontos para a 05"]
  H1["Handoff para a 04: histórico por cliente, sem dados pessoais"]

  I1 --> F1
  F1 --> S1
  S1 --> C1
  C1 -->|"sim"| A1
  C1 -->|"não, ajustar"| S1
  A1 --> C2
  C2 -->|"sim"| G1
  C2 -->|"não, ajustar"| A1
  G1 --> D3
  D3 -->|"Fase 1, abrir a Fase 2"| F2
  F2 --> S1
  D3 -->|"Fase 2, abrir a Fase 3"| F3
  I2 --> F3
  F3 --> S1
  D3 -->|"Fase 3, fases concluídas"| P1
  P1 --> C3
  C3 -->|"sim"| E1
  C3 -->|"não, ajustar"| P1
  E1 --> H1

  class C1,C2,C3 checkpoint
  class S1 subagente
  class E1,H1 entrega
  classDef checkpoint fill:#fff1e6,stroke:#e8803a,color:#7a3d0c
  classDef subagente fill:#e8f0fd,stroke:#1f4fa8,color:#173a7a
  classDef entrega fill:#e6f6ec,stroke:#16743b,color:#0f4f28
